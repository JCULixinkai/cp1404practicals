BoxLayout:
    orientation: 'vertical'
    padding: 10
    spacing: 10

    BoxLayout:
        orientation: 'horizontal'

        TextInput:
            id: input_miles
            text: '0'
            font_size: 32
            halign: 'center'
            multiline: False
            on_text: app.handle_calculate()

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.3

            Button:
                text: 'Up'
                font_size: 24
                background_color: (0.2, 0.2, 0.2, 1)
                color: (1, 1, 1, 1)
                on_press: app.handle_increment(1)

            Button:
                text: 'Down'
                font_size: 24
                background_color: (0.2, 0.2, 0.2, 1)
                color: (1, 1, 1, 1)
                on_press: app.handle_increment(-1)

    Label:
        id: output_label
        text: app.output_text
        font_size: 32
        color: (1, 1, 0, 1)
        halign: 'center'
        valign: 'middle'
        size_hint_y: None
        height: 50

    Label:
        text: 'Enter a number and press "Square"'
        font_size: 24
        color: (1, 1, 1, 1)
        halign: 'center'
        valign: 'middle'
        size_hint_y: None
        height: 50
